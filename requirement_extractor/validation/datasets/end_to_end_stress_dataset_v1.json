{
  "dataset_name": "lustre_requirement_pipeline_end_to_end_v1",
  "version": "1.0.0",
  "scenario_count": 30,
  "purpose": "Validate integration from raw/multi-turn user requests through requirement extraction, optional LLM fallback, final structured requirements, and AI Plausibility Agent.",
  "scope": {
    "single_and_multi_turn": true,
    "starts_from_raw_user_text": true,
    "llm_fallback_may_be_used": true,
    "ai_plausibility_llm_enrichment_enabled": true,
    "architecture_generation_in_scope": false
  },
  "outcome_distribution": {
    "BLOCKED_PLAUSIBILITY": 5,
    "READY_COHERENT": 7,
    "READY_AMBIGUOUS": 8,
    "CLARIFICATION_REQUIRED": 10
  },
  "language_distribution": {
    "fr": 11,
    "en": 11,
    "mixed": 8
  },
  "evaluation_contract": {
    "READY_COHERENT": "Requirements are complete and AI Plausibility must return COHERENT without blocking.",
    "READY_AMBIGUOUS": "Requirements are complete; architecture-dependent condition must produce WARNING/AMBIGUOUS without blocking.",
    "BLOCKED_PLAUSIBILITY": "Requirements are extractable but contain direct cross-field contradiction(s) that must block.",
    "CLARIFICATION_REQUIRED": "Required information is missing; pipeline must clarify and never invent missing values."
  },
  "important_notes": [
    "Do not require an exact LLM fallback call count unless authoritative runtime instrumentation exists.",
    "Current project contract uses GB/s values in target_read_gbps and target_write_gbps despite legacy field names.",
    "AI Plausibility LLM enrichment is non-decision-authoritative.",
    "Missing values must stay null until explicitly supplied by the user.",
    "E2E_0001 is intentionally BLOCKED_PLAUSIBILITY: its structured requirements imply ~19,531.25 TiB for only 500 TiB requested.",
    "End-to-End precedence: syntactic/domain-invalid values rejected by StateGuard (for example a read/write ratio whose sum is not 100) lead to CLARIFICATION_REQUIRED before AI Plausibility is invoked."
  ],
  "fields": [
    "requested_usable_capacity_tib",
    "client_count",
    "average_file_size_gb",
    "max_file_size_gb",
    "total_file_count",
    "read_write_ratio",
    "access_type",
    "target_read_gbps",
    "target_write_gbps",
    "ha_required",
    "max_budget_usd",
    "max_power_w",
    "annual_growth_percent"
  ],
  "scenarios": [
    {
      "id": "E2E_0001",
      "pipeline_outcome": "BLOCKED_PLAUSIBILITY",
      "category": "capacity_volume_mismatch",
      "language": "fr",
      "difficulty": "easy",
      "turns": [
        "Je veux 500 TiB utiles pour 200 clients, fichiers moyens de 2 GB et maximum 100 GB, environ 10 millions de fichiers, ratio lecture/écriture 70/30, accès mixed, 80 GB/s en lecture et 40 GB/s en écriture, HA obligatoire, budget maximum 100000 USD, puissance maximum 15000 W et croissance annuelle 30 %."
      ],
      "expected_final_requirements": {
        "requested_usable_capacity_tib": 500,
        "client_count": 200,
        "average_file_size_gb": 2,
        "max_file_size_gb": 100,
        "total_file_count": 10000000,
        "read_write_ratio": {
          "read_percent": 70,
          "write_percent": 30
        },
        "access_type": "mixed",
        "target_read_gbps": 80,
        "target_write_gbps": 40,
        "ha_required": true,
        "max_budget_usd": 100000,
        "max_power_w": 15000,
        "annual_growth_percent": 30
      },
      "expected": {
        "plausibility_status": "INCOHERENT",
        "should_block_recommendation": true,
        "blocking_issue_codes": [
          "DATASET_VOLUME_EXCEEDS_CAPACITY"
        ],
        "warning_issue_codes": [],
        "clarification_fields": [],
        "must_not_infer_missing_values": true
      },
      "notes": "Oracle corrected after the end-to-end smoke test. 2 GB x 10,000,000 files / 1024 = 19,531.25 TiB, so the request is directly inconsistent with 500 TiB usable."
    },
